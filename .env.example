# AI兼职规划助手 - 默认大模型配置接口 (Vite 环境变量需以 VITE_ 开头)

# 1. 接口基地址 Base URL (例如 DeepSeek 使用 https://api.deepseek.com)
# 如果是原生 Gemini，可填 https://generativelanguage.googleapis.com
VITE_TEXT_GENERATION_BASE_URL=https://api.deepseek.com

# 2. 您的 API Key 密钥
VITE_TEXT_GENERATION_API_KEY=

# 3. 大模型名称 (例如 deepseek-chat 或 gemini-1.5-flash 等)
VITE_TEXT_GENERATION_MODEL=deepseek-chat
